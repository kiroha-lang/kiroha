{
  "format": "kiroha-conformance/1",
  "language": "0.3.0/Web1",
  "scheduler": "virtual-fifo/1",
  "cases": [
    {
      "id": "large-sleep",
      "source": "try sleep(1e21) catch {e=>\"caught\"}",
      "expect": {
        "phase": "abort",
        "reason": "resource",
        "data": {
          "resource": "clock"
        }
      }
    },
    {
      "id": "large-http",
      "source": "try get(\"https://f.invalid/\",{timeout:1e21}) catch {e=>\"caught\"}",
      "expect": {
        "phase": "abort",
        "reason": "resource",
        "data": {
          "resource": "clock"
        }
      },
      "host": {
        "capabilities": {
          "http": [
            "https://f.invalid"
          ]
        }
      }
    },
    {
      "id": "large-sql",
      "source": "try sql(db(\"main\"),q`select 1`,{timeout:1e21}) catch {e=>\"caught\"}",
      "expect": {
        "phase": "abort",
        "reason": "resource",
        "data": {
          "resource": "clock"
        }
      },
      "fixtures": [
        {
          "id": "pool",
          "op": "pool",
          "match": {
            "alias": "main"
          },
          "ok": "p"
        }
      ],
      "host": {
        "capabilities": {
          "databases": [
            "main"
          ]
        }
      }
    },
    {
