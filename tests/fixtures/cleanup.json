{
  "format": "kiroha-conformance/1",
  "language": "0.8.0/Web1",
  "scheduler": "virtual-fifo/1",
  "cases": [
    {
      "id": "rollback-and-release-share-cleanup-budget",
      "source": "try tx(db(\"main\"),{timeout:1}){t=>sleep(100)} catch {e=>log(1)}",
      "host": {
        "capabilities": {
          "databases": [
            "main"
          ],
          "log": true
        },
        "limits": {
          "cleanup_ms": 1000
        }
      },
      "fixtures": [
        {
          "id": "pool",
          "op": "pool",
          "match": {
            "alias": "main"
          },
          "ok": "p"
        },
        {
          "id": "acq",
          "op": "acquire",
          "match": {
            "pool": "p"
          },
          "ok": "c"
        },
        {
          "id": "begin",
          "op": "begin",
          "match": {
            "connection": "c"
          },
          "ok": null
        },
        {
          "id": "rollback",
          "op": "rollback",
          "match": {
            "connection": "c"
          },
          "ok": null,
          "after_ms": 900
        },
        {
          "id": "release",
          "op": "release",
          "match": {
            "connection": "c"
          },
          "ok": null,
          "after_ms": 900
        },
        {
          "id": "log",
          "op": "log_line",
          "match": {},
          "ok": null
        }
      ],
      "expect": {
        "phase": "value",
        "json": "null",
        "starts": {
          "log": 1001
        }
      }
    },
