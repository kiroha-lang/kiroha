{
  "format": "kiroha-conformance/1",
  "language": "0.8.0/Web1",
  "scheduler": "virtual-fifo/1",
  "cases": [
    {
      "id": "typed-parameter",
      "source": "type Name={name:str}; name=\"x'); drop table t; --\"; sql[Name](db(\"main\"),{max_rows:2}){select ${name} as name}.one().name",
      "host": {
        "capabilities": {
          "databases": [
            "main"
          ]
        }
      },
      "fixtures": [
        {
          "id": "pool",
          "op": "pool",
          "match": {
            "alias": "main"
          },
          "ok": "p"
        },
        {
          "id": "acq",
          "op": "acquire",
          "match": {
            "pool": "p"
          },
          "ok": "c"
        },
        {
          "id": "q",
          "op": "execute",
          "match": {
            "connection": "c",
            "parameters": [
              {
                "oid": 25,
                "value": "x'); drop table t; --"
              }
            ],
            "sql": "select  $1  as name"
          },
          "ok": {
            "columns": [
              {
                "name": "name",
                "oid": 25
              }
            ],
            "rows": [
              [
                "x'); drop table t; --"
              ]
            ],
            "count": "1",
            "outcome": "committed"
          }
        },
        {
          "id": "rel",
          "op": "release",
          "match": {
            "connection": "c",
            "disposition": "reset"
          },
          "ok": null
        }
      ],
      "expect": {
        "phase": "value",
        "json": "\"x'); drop table t; --\""
      }
    },
