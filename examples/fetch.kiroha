// HTTP client with bounded concurrency and retries.
// kiroha run examples/fetch.kiroha --json --host examples/fetch.host.json
base = "https://api.github.com";
repos = ["rust-lang/rust", "tokio-rs/tokio"];
type Repo = open({full_name:str, stargazers_count:int});
repos.parallel(2){r =>
  retry({attempts:3, when:{e => e.code == "network" || e.code == "timeout"}, delay:200}){() =>
    get(url(base, ["repos"] + r.split("/")), {headers:{"User-Agent":"kiroha-example"}}) | check(Repo)
  }.pick(["full_name", "stargazers_count"])
}
